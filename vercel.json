{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/salas",
      "destination": "/catalogo?c=salas"
    },
    {
      "source": "/comedores",
      "destination": "/catalogo?c=comedores"
    },
    {
      "source": "/producto/:id",
      "destination": "/producto?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
