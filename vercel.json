{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/salas", "destination": "/catalogo.html?c=salas" },
    { "source": "/cocinas", "destination": "/catalogo.html?c=cocinas" },
    { "source": "/comedores", "destination": "/catalogo.html?c=comedores" },
    { "source": "/recamaras", "destination": "/catalogo.html?c=recamaras" },
    { "source": "/producto/:id", "destination": "/producto.html?id=:id" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
